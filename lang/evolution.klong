: HERMETIC-Ω recursive sphere evolution in Klong
: G_{n+1} = Exp(G_n)(η V)

.norm {:+/*x}
.dot {:+/*x'y}
.sinc {:[.abs(x)<1e-12;1-(x*x)/6; .sin(x)/x]}

.sphere_exp {
  x::x;
  v::y;
  nv::.sqrt(.norm(v));
  c::.cos(nv);
  s::.sinc(nv);
  (c*x)+(s*v)
}

.evolve {
  x::x;
  v::y;
  eta::z;
  steps::w;
  :[steps=0; x; .evolve(.sphere_exp(x;eta*v);v;eta;steps-1)]
}

.is_unit {:.abs(.norm(x)-1)<1e-8}
.is_tangent {:.abs(.dot(x;y))<1e-8}
